# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where this application is hosted (used for QR ticket validation URLs and email links).
APP_URL="http://localhost:3000"

# RAZORPAY CREDENTIALS (Use Test Mode keys rzp_test_... during development, Live Mode keys rzp_live_... in production)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# TRANSACTIONAL EMAIL PROVIDER (Configure EITHER Resend OR SMTP/Brevo)
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Christmas Night 2026 <tickets@yourdomain.com>"

# Option 2: Brevo / Custom SMTP via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# TICKET QR SIGNING SECRET (Random 32+ char secret for cryptographic ticket verification tokens)
TICKET_SIGNING_SECRET=""

# OPTIONAL: Firebase Admin Service Account JSON string for server-side Firestore sync in production
FIREBASE_SERVICE_ACCOUNT_JSON=""
